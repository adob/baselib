{
    "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
    "name": "baselib",
    "version": "0.0.0",
    "dependencies": {
        "fmt": "https://github.com/fmtlib/fmt.git#12.1.0",
        "buildtool": "https://github.com/adob/buildtool.git#3a25aa64ab643f76260cba9e4818954ea4dac038",
        "boost_assert": "https://github.com/boostorg/assert.git#boost-1.87.0",
        "boost_circular_buffer": "https://github.com/boostorg/circular_buffer.git#boost-1.87.0",
        "boost_concept_check": "https://github.com/boostorg/concept_check.git#boost-1.87.0",
        "boost_config": "https://github.com/boostorg/config.git#boost-1.87.0",
        "boost_core": "https://github.com/boostorg/core.git#boost-1.87.0",
        "boost_move": "https://github.com/boostorg/move.git#boost-1.87.0",
        "boost_preprocessor": "https://github.com/boostorg/preprocessor.git#boost-1.87.0",
        "boost_static_assert": "https://github.com/boostorg/static_assert.git#boost-1.87.0",
        "boost_throw_exception": "https://github.com/boostorg/throw_exception.git#boost-1.87.0",
        "boost_type_traits": "https://github.com/boostorg/type_traits.git#boost-1.87.0"
    },
    "build": {
        "includeDir": ".",
        "srcDir": ".",
        "srcFilter": "-<*>",
        "extraScript": "platformio/build.py"
    }
}
